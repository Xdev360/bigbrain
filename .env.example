# Copy to .env and fill in. These are read server-side by api/inquiry.js —
# they are never written into the front-end bundle.
# Local testing of the form needs `vercel dev`; a plain static server has no /api.
# On Vercel: Project Settings → Environment Variables (same names)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: custom domain for og:image / canonical (defaults to the Vercel production URL)
SITE_URL=
